[Unit]
Description=CVI live re-verification canary (verify --live-sample)
Documentation=file://{{CVI_ROOT}}/docs/v2/03-ANTI-MANIPULATION.md
# Re-fetches the nightly sample from GitHub and writes the verdict file to
# $CVI_ROOT/data/canary/verdicts-<seed>.json. A held row (source_drift or
# worse) makes the run exit 1; promotion must consume that verdict file.

[Service]
Type=oneshot
Environment=CVI_ROOT={{CVI_ROOT}}
Environment=CVI_PY={{CVI_ROOT}}/.venv/bin/python
WorkingDirectory={{CVI_ROOT}}
ExecStart={{CVI_ROOT}}/scripts/canary.sh run
